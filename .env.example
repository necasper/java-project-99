# Скопируйте в .env для локальной разработки:
#   copy .env.example .env
#
# PowerShell (если не используете ./gradlew bootRun):
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+)=(.*)$') {
#       Set-Item -Path "env:$($matches[1].Trim())" -Value $matches[2].Trim()
#     }
#   }

SPRING_PROFILES_ACTIVE=dev
PORT=8080
ADMIN_PASSWORD=your-local-admin-password

# Для загрузки source context в Sentry при сборке (./gradlew build)
SENTRY_AUTH_TOKEN=your-org-auth-token

# При запуске JAR с OpenTelemetry-агентом Sentry
SENTRY_AUTO_INIT=false
